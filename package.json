{
  "name": "la-trolina-fighter",
  "version": "0.2.0",
  "private": true,
  "description": "La Trolina Fighters: juego de lucha 2D en Canvas (1 jugador vs CPU), botellín compartido y escenario de tres planos",
  "scripts": {
    "test": "node --test tests/bottle.test.cjs tests/stage.test.cjs tests/rules.test.cjs",
    "build": "python3 tools/build_demo.py",
    "rebuild:assets": "python3 tools/rebuild_assets.py",
    "preview:gif": "python3 tools/render_preview.py",
    "serve": "python3 -m http.server 8000",
    "build:characters": "python3 tools/build_characters.py"
  },
  "engines": {
    "node": ">=18"
  }
}
